# Altus Leave Management System — environment variables
# Copy to .env (development) or .env.test (tests) and fill in values.
# Never commit real values. Production values belong in the server's secret store.

# --- Runtime ---
# development | test | production
NODE_ENV=
PORT=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=
# Number of reverse-proxy hops to trust (1 behind Nginx)
TRUST_PROXY=

# --- Database (MySQL 8) ---
# Each environment uses its own database and user. Test database names must end in _test.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=
DB_SSL=
# Optional: separate account used only by `npm run migrate` (needs DDL and trigger rights)
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=

# --- URLs ---
APP_BASE_URL=
CLIENT_ORIGIN=

# --- Sessions ---
# At least 32 random characters in production
SESSION_SECRET=
SESSION_IDLE_MINUTES=
SESSION_ABSOLUTE_HOURS=
# Sign-in attempts per IP address per 15 minutes (default 30)
SIGN_IN_RATE_LIMIT=
COOKIE_SECURE=

# --- Microsoft Entra ID (OpenID Connect) — the only way to sign in ---
# Local redirect URI: http://localhost:5173/api/auth/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# --- Email (Microsoft Graph; see docs/email-setup.md) ---
# graph | disabled  (disabled is refused in production). Uses ENTRA_TENANT_ID.
MAIL_TRANSPORT=
# The mailbox emails are sent from, e.g. leave@altus.co.zm
MAIL_SENDER_ADDRESS=
# A separate app registration with the Mail.Send application permission
GRAPH_MAIL_CLIENT_ID=
GRAPH_MAIL_CLIENT_SECRET=
# on | off. Email sending and daily reminders run inside the API process (default on; off in tests)
BACKGROUND_JOBS=

# --- Supporting documents ---
# Absolute path outside the web root
DOCUMENT_STORAGE_DIR=
DOCUMENT_MAX_BYTES=
