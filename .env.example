# Altus Leave Management System — environment variables
# Copy to .env (development) or .env.test (tests) and fill in values.
# Never commit real values. Production values belong in the server's secret store.

# --- Runtime ---
# development | test | production
NODE_ENV=
PORT=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=
# Number of reverse-proxy hops to trust (1 behind Nginx)
TRUST_PROXY=

# --- Database (MySQL 8) ---
# Each environment uses its own database and user. Test database names must end in _test.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=
DB_SSL=
# Optional: separate account used only by `npm run migrate` (needs DDL and trigger rights)
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=

# --- URLs ---
APP_BASE_URL=
CLIENT_ORIGIN=

# --- Sessions ---
# At least 32 random characters in production
SESSION_SECRET=
SESSION_IDLE_MINUTES=
SESSION_ABSOLUTE_HOURS=
COOKIE_SECURE=

# --- Microsoft Entra ID (OpenID Connect) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

# --- Development-only sign-in adapter ---
# Refused at startup when NODE_ENV=production.
DEV_AUTH_ENABLED=

# --- Email ---
# graph | smtp | disabled  (disabled is refused in production)
MAIL_TRANSPORT=
MAIL_SENDER_ADDRESS=
GRAPH_MAIL_CLIENT_ID=
GRAPH_MAIL_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Supporting documents ---
# Absolute path outside the web root
DOCUMENT_STORAGE_DIR=
DOCUMENT_MAX_BYTES=
