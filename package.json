{
  "name": "altus-leave",
  "private": true,
  "type": "module",
  "description": "Altus Financial Services Limited \u2014 HR Leave Management System",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace server",
    "migrate": "npm run migrate --workspace server",
    "bootstrap:admin": "npm run bootstrap:admin --workspace server --",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "set-env": "node scripts/set-env.mjs",
    "import-inventory": "npm run import-inventory --workspace server --"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  }
}
